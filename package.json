{
  "name": "neotree-reporting",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-screen-capture": "~58.0.6",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-android.js",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/lib.test.ts",
    "assets": "python3 scripts/generate-brand-assets.py",
    "build:apk": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "build:play": "eas build --platform android --profile play",
    "submit:play": "eas submit --platform android --profile play",
    "build:ios-simulator": "eas build --platform ios --profile ios-simulator"
  },
  "private": true
}
