# Copy to .env and uncomment only the values you use.
# Normal local development needs no .env when config/countries.local.json exists.

# Optional: load the country registry from a different JSON file.
# NEOTREE_COUNTRIES_FILE=config/countries.local.json

# Optional: set this only when your EAS project requires an explicit project ID.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Required together only for a locally signed Android release build.
# Use an absolute path to your private keystore. Never commit real values.
# NEOTREE_RELEASE_KEYSTORE=/absolute/path/to/neotree-release.keystore
# NEOTREE_RELEASE_STORE_PASSWORD=replace-with-store-password
# NEOTREE_RELEASE_KEY_ALIAS=replace-with-key-alias
# NEOTREE_RELEASE_KEY_PASSWORD=replace-with-key-password
